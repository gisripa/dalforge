# Code generated by dalforge. DO NOT EDIT.
version: "2"
sql:
  - engine: postgresql
    schema: schema/schema.sql
    queries:
      - queries/generated
      - queries/custom # user-owned: dalforge never writes here
    strict_function_checks: true
    strict_order_by: true
    gen:
      go:
        package: sqlcdb
        out: gen/sqlcdb
        sql_package: pgx/v5
        emit_interface: true
        emit_pointers_for_null_types: true
        emit_exact_table_names: true
        initialisms: [id, ip, url, uri, uuid, http, json, api, sql]
        overrides:
          # http_request_log
          - column: http_request_log.id
            go_type:
              type: int64
          - column: http_request_log.ok
            go_type:
              type: bool
          - column: http_request_log.i32
            go_type:
              type: int32
          - column: http_request_log.s32
            go_type:
              type: int32
          - column: http_request_log.sf32
            go_type:
              type: int32
          - column: http_request_log.i64
            go_type:
              type: int64
          - column: http_request_log.s64
            go_type:
              type: int64
          - column: http_request_log.sf64
            go_type:
              type: int64
          - column: http_request_log.u32
            go_type:
              type: int64
          - column: http_request_log.f32
            go_type:
              type: int64
          - column: http_request_log.u64
            go_type:
              type: string
          - column: http_request_log.f64
            go_type:
              type: string
          - column: http_request_log.fl
            go_type:
              type: float32
          - column: http_request_log.db
            go_type:
              type: float64
          - column: http_request_log.path
            go_type:
              type: string
          - column: http_request_log.body
            go_type:
              type: byte
              slice: true
          - column: http_request_log.color
            go_type:
              type: string
          - column: http_request_log.created_at
            go_type:
              import: time
              type: Time
          - column: http_request_log.finished_at
            go_type:
              import: time
              type: Time
              pointer: true
          - column: http_request_log.note
            go_type:
              type: string
              pointer: true
          - column: http_request_log.tags
            go_type:
              type: string
              slice: true
          - column: http_request_log.headers
            go_type:
              import: encoding/json
              type: RawMessage
          - column: http_request_log.meta
            go_type:
              import: encoding/json
              type: RawMessage
          - column: http_request_log.nested
            go_type:
              import: encoding/json
              type: RawMessage
          - column: http_request_log.nested_list
            go_type:
              import: encoding/json
              type: RawMessage
          - column: http_request_log.status
            go_type:
              type: int32
          - column: http_request_log.req_id
            go_type:
              import: github.com/google/uuid
              type: UUID
          - column: http_request_log.amount
            go_type:
              type: string
          - column: http_request_log.payload
            go_type:
              import: encoding/json
              type: RawMessage
          - column: http_request_log.embedding
            go_type:
              import: github.com/pgvector/pgvector-go
              type: Vector
          - column: http_request_log.ratio
            go_type:
              type: float64
          - column: http_request_log.day
            go_type:
              import: time
              type: Time
          - column: http_request_log.client_ip
            go_type:
              type: string
          # cast parameters: nullable → pointer, required → value
          - db_type: pg_catalog.numeric
            nullable: true
            go_type:
              type: string
              pointer: true
          - db_type: pg_catalog.numeric
            go_type:
              type: string
          - db_type: timestamptz
            nullable: true
            go_type:
              import: time
              type: Time
              pointer: true
          - db_type: timestamptz
            go_type:
              import: time
              type: Time
          - db_type: jsonb
            nullable: true
            go_type:
              import: encoding/json
              type: RawMessage
          - db_type: jsonb
            go_type:
              import: encoding/json
              type: RawMessage
          - db_type: uuid
            nullable: true
            go_type:
              import: github.com/google/uuid
              type: UUID
