# Code generated by dalforge. DO NOT EDIT.
version: "2"
sql:
  - engine: postgresql
    schema: schema/schema.sql
    queries:
      - queries/generated
      - queries/custom # user-owned: dalforge never writes here
    strict_function_checks: true
    strict_order_by: true
    gen:
      go:
        package: sqlcdb
        out: gen/sqlcdb
        sql_package: pgx/v5
        emit_interface: true
        emit_pointers_for_null_types: true
        emit_exact_table_names: true
        initialisms: [id, ip, url, uri, uuid, http, json, api, sql]
        overrides:
          # item
          - column: item.tenant_id
            go_type:
              import: github.com/google/uuid
              type: UUID
          - column: item.id
            go_type:
              import: github.com/google/uuid
              type: UUID
          - column: item.sku
            go_type:
              type: string
          - column: item.name
            go_type:
              type: string
          - column: item.color
            go_type:
              type: string
              pointer: true
          - column: item.version
            go_type:
              type: int64
          - column: item.created_at
            go_type:
              import: time
              type: Time
          - column: item.updated_at
            go_type:
              import: time
              type: Time
          - column: item.deleted_at
            go_type:
              import: time
              type: Time
              pointer: true
          # insert parameters (cast, nullable): every field is a pointer
          - db_type: uuid
            nullable: true
            go_type:
              import: github.com/google/uuid
              type: UUID
              pointer: true
          - db_type: timestamptz
            nullable: true
            go_type:
              import: time
              type: Time
              pointer: true
