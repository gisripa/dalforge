# Code generated by dalforge. DO NOT EDIT.
version: "2"
sql:
  - engine: postgresql
    schema: schema/schema.sql
    queries:
      - queries/generated
      - queries/custom # user-owned: dalforge never writes here
    strict_function_checks: true
    strict_order_by: true
    gen:
      go:
        package: sqlcdb
        out: gen/sqlcdb
        sql_package: pgx/v5
        emit_interface: true
        emit_pointers_for_null_types: true
        emit_exact_table_names: true
        initialisms: [id, ip, url, uri, uuid, http, json, api, sql]
        rename:
          accounts: Account
        overrides:
          # accounts
          - column: accounts.id
            go_type:
              import: github.com/google/uuid
              type: UUID
          - column: accounts.name
            go_type:
              type: string
          # cast parameters: nullable → pointer, required → value
          - db_type: uuid
            nullable: true
            go_type:
              import: github.com/google/uuid
              type: UUID
              pointer: true
          - db_type: uuid
            go_type:
              import: github.com/google/uuid
              type: UUID
